{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash Tools/check_folder_structure.sh --quiet"
          },
          {
            "type": "command",
            "command": "bash Tools/check_spec_consistency.sh --quiet"
          },
          {
            "type": "command",
            "command": "bash Tools/check_missing_scripts.sh --quiet"
          }
        ]
      }
    ]
  }
}
